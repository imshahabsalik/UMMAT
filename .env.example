UMMAT_ENV=production
UMMAT_SECRET_KEY=replace-with-a-long-random-secret
UMMAT_HTTPS=1
UMMAT_PUBLIC_BASE_URL=https://your-domain.example
UMMAT_DATABASE_PATH=/persistent/path/ummat.sqlite3
UMMAT_BACKUP_DIR=/persistent/path/backups
UMMAT_BACKUP_RETENTION_DAYS=30
# SMTP is free when supplied by an existing provider/account. Keep credentials private.
UMMAT_SMTP_HOST=
UMMAT_SMTP_PORT=587
UMMAT_SMTP_USERNAME=
UMMAT_SMTP_PASSWORD=
UMMAT_EMAIL_FROM=
UMMAT_EMAIL_NAME=UMMAT
# Optional: copy each new buyer enquiry to the salesperson (configure after assigning an address).
UMMAT_SALES_EMAIL=
# Set to 1 for implicit TLS SMTP on port 465.
UMMAT_SMTP_SSL=0
# Only enable when the hosting proxy setup is trusted and understood.
UMMAT_TRUST_PROXY=0
